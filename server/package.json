{
  "name": "@fintrack/server",
  "private": true,
  "type": "module",
  "scripts": {
    "db": "tsx scripts/dev-db.ts",
    "dev": "tsx watch src/dev.ts",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "17.11.0-beta.19",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
