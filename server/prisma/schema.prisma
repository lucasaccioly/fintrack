generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
}

enum Kind {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  isGuest      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]

  @@index([isGuest, createdAt])
}

model Account {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  initialBalance Int           @default(0)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]

  @@index([userId])
}

model Category {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String
  kind         Kind
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  kind        Kind
  amount      Int
  date        DateTime @db.Date
  description String
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String
  limit      Int

  @@unique([categoryId, month])
  @@index([userId, month])
}
